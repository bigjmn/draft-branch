rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function member(projectId) {
      return signedIn() && exists(/databases/$(database)/documents/projects/$(projectId))
        && !get(/databases/$(database)/documents/projects/$(projectId)).data.get("deleting", false)
        && exists(/databases/$(database)/documents/projects/$(projectId)/members/$(request.auth.uid));
    }
    function owner(projectId) {
      return member(projectId) && get(/databases/$(database)/documents/projects/$(projectId)/members/$(request.auth.uid)).data.role == 'owner';
    }
    match /profiles/{uid} {
      allow get: if true;
      allow list, delete: if false;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && request.resource.data.keys().hasAll(['name', 'job', 'company', 'bio', 'avatarId', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['name', 'job', 'company', 'bio', 'avatarId', 'updatedAt'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100
        && request.resource.data.job is string && request.resource.data.job.size() <= 100
        && request.resource.data.company is string && request.resource.data.company.size() <= 100
        && request.resource.data.bio is string && request.resource.data.bio.size() <= 500
        && request.resource.data.avatarId is string && (request.resource.data.avatarId == '' || request.resource.data.avatarId.matches('^[a-f0-9-]{36}$'))
        && request.resource.data.updatedAt == request.time;
    }
    match /projectDeletions/{id} { allow read, write: if false; }
    match /invitationMail/{id} { allow read, write: if false; }
    match /invitationLimits/{id} { allow read, write: if false; }
    match /emulatorMail/{id} { allow read, write: if false; }
    // All mutations go through authenticated callable APIs / trusted workers.
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
      match /projects/{projectId} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow write: if false;
      }
    }
    match /projects/{projectId} {
      allow read: if member(projectId);
      allow write: if false;
      match /comments/{commentId} {
        allow read: if member(projectId);
        allow create: if owner(projectId)
          && request.resource.data.keys().hasAll(['authorUid','authorName','branch','blockId','quote','text','resolved','createdAt'])
          && request.resource.data.keys().hasOnly(['authorUid','authorName','branch','blockId','quote','text','resolved','createdAt'])
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.authorName is string && request.resource.data.authorName.size() <= 100
          && request.resource.data.branch is string && request.resource.data.branch.size() <= 64
          && exists(/databases/$(database)/documents/projects/$(projectId)/branches/$(request.resource.data.branch))
          && request.resource.data.blockId is string && request.resource.data.blockId.size() > 0 && request.resource.data.blockId.size() <= 128
          && request.resource.data.quote is string && request.resource.data.quote.size() <= 500
          && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 2000
          && request.resource.data.resolved == false && request.resource.data.createdAt == request.time;
        allow update: if owner(projectId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['resolved']) && request.resource.data.resolved is bool;
        allow delete: if owner(projectId);
      }
      match /members/{uid} { allow read: if member(projectId); allow write: if false; }
      match /branches/{branchId} { allow read: if member(projectId); allow write: if false; }
      match /commits/{commitId} { allow read: if member(projectId); allow write: if false; }
      match /workingDrafts/{uid}/branches/{branchId} {
        allow read: if member(projectId) && request.auth.uid == uid;
        allow write: if false;
      }
      match /uploads/{uploadId} {
        allow read: if member(projectId) && resource.data.actorUid == request.auth.uid;
        allow write: if false;
      }
      match /operations/{operationId} {
        allow read: if member(projectId) && (resource.data.actor.uid == request.auth.uid || owner(projectId));
        allow write: if false;
      }
      match /mergeRequests/{requestId} { allow read: if member(projectId); allow write: if false; }
      match /invitations/{invitationId} { allow read: if owner(projectId); allow write: if false; }
      match /requests/{requestId} { allow read, write: if false; }
    }
  }
}
