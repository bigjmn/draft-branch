rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Profiles are created by the onUserCreated Cloud Function (Admin SDK),
    // which bypasses these rules. Clients can only read their own.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
