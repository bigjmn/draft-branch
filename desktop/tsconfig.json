{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["node", "vite/client"],
    "paths": {
      "@/lib/projects/client": ["./src/renderer/data/client.ts"],
      "next/link": ["./src/renderer/shims/next-link.tsx"],
      "next/navigation": ["./src/renderer/shims/next-navigation.ts"],
      "@/*": ["../src/*"]
    }
  },
  "include": ["src", "tests", "scripts", "vite.config.mts"]
}
