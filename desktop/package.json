{
  "name": "draftbranch-desktop",
  "productName": "DraftBranch",
  "version": "0.1.0",
  "private": true,
  "description": "DraftBranch for desktop: an offline-first screenplay editor with Git-style version control.",
  "author": "J Nicks Productions",
  "main": "dist/main/index.cjs",
  "desktopName": "draftbranch.desktop",
  "scripts": {
    "predev": "node scripts/check-root.mjs",
    "dev": "node scripts/dev.mjs",
    "prebuild": "node scripts/check-root.mjs",
    "build": "node scripts/build.mjs",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "format": "prettier --write src tests scripts \"*.mts\" \"*.json\" \"*.yml\" README.md",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.8"
  }
}
